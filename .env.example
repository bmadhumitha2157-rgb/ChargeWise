# ---- Backend (Render/Railway environment variables) ----
# Comma-separated list of frontend origins allowed by CORS (no trailing slash, no wildcard)
ALLOWED_ORIGINS=http://localhost:5173
# Optional: override predictions file location
# PREDICTIONS_PATH=reports/predictions.json
# ---- Frontend (frontend/.env or Vercel environment variable) ----
# VITE_API_URL=https://YOUR-BACKEND-URL
